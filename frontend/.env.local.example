# ─── MeetMind Frontend — Environment Variables ─────────────────────────────────
# Copy this file to .env.local and fill in all values before running.

# ── NextAuth ───────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3015
NEXTAUTH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET

# ── Google OAuth (leave blank to disable) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── API URLs ───────────────────────────────────────────────────────────────────
# Browser-side: the server IP or domain (requests go through nginx or directly)
NEXT_PUBLIC_API_URL=http://localhost:3014

# Server-side (SSR + NextAuth): direct to backend container
# In docker-compose this is overridden to http://backend:3014
BACKEND_URL=http://localhost:3014

# ── Recording ──────────────────────────────────────────────────────────────────
# Maximum audio duration per uploaded chunk, in seconds (default: 30)
NEXT_PUBLIC_CHUNK_DURATION_SECONDS=30
