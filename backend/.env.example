# ─── MeetMind Backend — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in all values before running.

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3014
ENVIRONMENT=production

# ── CORS — comma-separated list of allowed origins ───────────────────────────
CORS_ORIGINS=http://localhost:3015,http://localhost:3002

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=meetmind

# ── Redis (Celery broker + token blacklist) ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3014/auth/google/callback

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── AWS S3 ────────────────────────────────────────────────────────────────────
# NO ACCESS KEYS — uses IAM instance role on EC2
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET=your-bucket-name

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=Transcript-mom

# ── Embedding ─────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# ── Optional: HMAC secret for verifying callbacks from Backend 1 ──────────────
BACKEND1_HMAC_SECRET=

# ── Audio Storage Backend ─────────────────────────────────────────────────────
# "s3"    → upload/serve audio via AWS S3 presigned URLs (default)
# "local" → store audio on the local file system in AUDIO_LOCAL_PATH
AUDIO_STORAGE_BACKEND=s3
AUDIO_LOCAL_PATH=./audio_files

# ── Processing Queue ─────────────────────────────────────────────────────────
# Admin-configurable processing window (HH:MM in UTC). The Celery Beat task
# only dispatches items to the external API within this window.
PROCESSING_WINDOW_START=09:00
PROCESSING_WINDOW_END=17:00
PROCESSING_MAX_RETRIES=3
PROCESSING_RETRY_DELAY_MINUTES=5
PROCESSING_POLL_INTERVAL_SECONDS=60

# External API base URL. The code will append /transcript automatically.
# Example: https://api.example.com  →  calls https://api.example.com/transcript
EXTERNAL_API_URL=
